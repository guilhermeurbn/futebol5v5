{
  "appId": "pt.natrave.com",
  "appName": "NaTrave 5v5",
  "webDir": "static",
  "appendUserAgent": "Capacitor NaTraveApp/1.0",
  "server": {
    "url": "https://natrave.pt/login?mode=app",
    "cleartext": true,
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": [
      "natrave.pt",
      "*.natrave.pt",
      "127.0.0.1",
      "localhost"
    ]
  },
  "ios": {
    "allowsLinkPreview": false
  },
  "plugins": {
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#121217",
      "overlaysWebView": true
    },
    "Keyboard": {
      "resize": "body",
      "style": "DARK",
      "resizeOnKeyboardDeviceOption": true
    },
    "Haptics": {}
  }
}
